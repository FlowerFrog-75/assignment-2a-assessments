# Production settings for deploy/docker-compose.yml. Copy to deploy/.env.
# Never commit deploy/.env.

# The address people use, e.g. wallet.kgsc.qld.edu.au. Its DNS A record must
# point at this server so Caddy can get an HTTPS certificate.
DOMAIN=wallet.example.edu.au

# Encrypts 2FA secrets in the database. At least 32 characters:
#   openssl rand -hex 32
# Back it up somewhere safe. If it's lost, every staff member must set up 2FA again.
APP_SECRET=

# MongoDB app account (same values as MONGO_APP_USERNAME / MONGO_APP_PASSWORD in
# mongodb/.env). "mongodb" is the database container's name on its Docker network.
MONGODB_URI=mongodb://dsw_app:change-me@mongodb:27017/digital_skills_wallet?authSource=digital_skills_wallet

# The server user that ran `pnpm fabric:up` (see `id -u` and `id -g`).
APP_UID=1000
APP_GID=1000

# Optional
# LEDGER_RETRY_MS=300000

# Optional: the AI assistant. Without a key the AI buttons say "AI isn't set up".
# Students' written answers are only sent to the AI when an admin turns on
# "Let teachers use AI when marking" in School Settings.
# ANTHROPIC_API_KEY=
# AI_MODEL=
# AI_DAILY_JOBS=20
# AI_MAX_ITEMS_PER_JOB=10

# Leave this off on a real school's server: sample accounts use password123 and skip 2FA.
# Only set it to "on" on a server that exists to show the sample school.
# SAMPLE_SCHOOL=off
