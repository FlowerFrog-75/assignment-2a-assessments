# Settings for the API server (server/). Copy to .env.local and fill in.
# Never commit real values. These have no VITE_ prefix, so Vite never sends
# them to the browser.

# Connection string for YOUR MongoDB server (see mongodb/README.md).
# The username and password are the app account (MONGO_APP_USERNAME /
# MONGO_APP_PASSWORD in mongodb/.env), not the root account.
# authSource must be the app database, because that is where the user was created.
#
# Database on the same machine as the app:
MONGODB_URI=mongodb://dsw_app:change-me-app-password@127.0.0.1:27017/digital_skills_wallet?authSource=digital_skills_wallet
#
# Database on a separate server (private network address, with TLS enabled on mongod):
# MONGODB_URI=mongodb://dsw_app:<password>@10.0.0.5:27017/digital_skills_wallet?authSource=digital_skills_wallet&tls=true

# Port for the API server (Vite proxies /api here during development).
# API_PORT=4000

# Optional: connection pool size per app instance (default 10).
# MONGODB_MAX_POOL_SIZE=10

# REQUIRED in production: encrypts 2FA secrets stored in MongoDB.
# At least 32 characters. Generate with: openssl rand -hex 32
# Keep a copy somewhere safe: if it is lost, every user must set up 2FA again.
APP_SECRET=

# Optional: Hyperledger Fabric (see fabric/README.md). The defaults work with
# `pnpm fabric:up` on the same machine.
# FABRIC_SCHOOL_PEER_ENDPOINT=localhost:7051
# FABRIC_KANAVOOGLE_PEER_ENDPOINT=localhost:9051
# FABRIC_ORGANIZATIONS_DIR=fabric/organizations

# Optional: how often unsynced skill coins are retried on the ledger (ms, default 5 minutes),
# or LEDGER_SYNC=off to turn automatic syncing off (then run `pnpm ledger:sync` yourself).
# LEDGER_RETRY_MS=300000
# LEDGER_SYNC=off

# Production only:
# NODE_ENV=production       # secure cookies, APP_SECRET required
# TRUST_PROXY=1             # behind Caddy/nginx, so audit logs and rate limits see the client's real IP

# Optional: the AI assistant (question generator, marking suggestions, feedback drafts).
# With a key the app uses Claude; without one the AI buttons say "AI isn't set up".
# The key stays on the server and is never sent to browsers.
# ANTHROPIC_API_KEY=
# AI_MODEL=                 # defaults to the model in server/ai/provider.ts
# AI_VALIDATOR_MODEL=       # model for the validator agent (defaults to AI_MODEL)
# AI_DAILY_JOBS=20          # question-generation runs per teacher per day
# AI_MAX_ITEMS_PER_JOB=10   # questions per run
# AI_OFFLINE_DEMO=on        # scripted stand-in, labelled "Offline demo (not real AI)", for showing the screens without a key

# Sample school (pnpm sample:school). Its accounts use password123 and skip 2FA, so they only
# work while sample mode is on. On by default in development, off in production unless set to "on".
# Never turn it on for a real school.
# SAMPLE_SCHOOL=off
