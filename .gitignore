# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow committing env templates (real .env files stay ignored)
!.env.example

# MongoDB backups made by mongodb/backup.sh
/mongodb/backups/

# Hyperledger Fabric: generated certificates/keys, channel artifacts, chaincode packages
/fabric/organizations/
/fabric/channel-artifacts/
/fabric/packages/
/fabric/.demo/
/fabric/chaincode/skillcoin/node_modules/
/fabric/chaincode/skillcoin/dist/
